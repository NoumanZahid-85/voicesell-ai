# Copy to backend/.env and fill in real values for local development.
# In production (Render), these are injected via the dashboard / render.yaml — do not commit real secrets.

# ── Database (required) ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://voicesell:voicesell@localhost:5432/voicesell
SUPABASE_URL=
SUPABASE_KEY=

# ── Vector DB (required) ─────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── LLM Providers (at least one required for Phase 2+) ───────────
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_NAME=
GEMINI_API_KEY=

# ── Voice Services (required for Phase 3+) ───────────────────────
DAILY_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# ── Redis (required for Phase 7+) ─────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Observability (optional) ──────────────────────────────────────
LANGSMITH_API_KEY=
OTEL_EXPORTER_ENDPOINT=

# ── Application ─────────────────────────────────────────────────
APP_NAME=voicesell
DEBUG=true
LOG_LEVEL=info
